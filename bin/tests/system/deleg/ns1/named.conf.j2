// NS1

options {
	query-source address 10.53.0.1;
	notify-source 10.53.0.1;
	transfer-source 10.53.0.1;
	port @PORT@;
	pid-file "named.pid";
	listen-on { 10.53.0.1; };
	listen-on-v6 { none; };
	recursion no;
	dnssec-validation no;
	allow-transfer { any; };
};

dnssec-policy nsec {
	dnskey-ttl 3600;
	parent-ds-ttl 3600;
	keys {
		zsk key-directory lifetime 60d algorithm ecdsa256;
		ksk key-directory lifetime unlimited algorithm ecdsa256;
	};
};

dnssec-policy nsec3 {
	dnskey-ttl 3600;
	parent-ds-ttl 3600;
	nsec3param iterations 0 optout no;
	keys {
		zsk key-directory lifetime 60d algorithm ecdsa256;
		ksk key-directory lifetime unlimited algorithm ecdsa256;
	};
};

dnssec-policy optout {
	dnskey-ttl 3600;
	parent-ds-ttl 3600;
	nsec3param iterations 0 optout yes;
	keys {
		zsk key-directory lifetime 60d algorithm ecdsa256;
		ksk key-directory lifetime unlimited algorithm ecdsa256;
	};
};

zone nsec {
	type primary;
	file "nsec.db";
	initial-file "example.db.in";
	dnssec-policy nsec;
	allow-update { any; };
};

zone nsec3 {
	type primary;
	file "nsec3.db";
	initial-file "example.db.in";
	dnssec-policy nsec3;
};

zone optout {
	type primary;
	file "optout.db";
	initial-file "example.db.in";
	dnssec-policy optout;
};

zone unsigned {
	type primary;
	file "unsigned.db";
	initial-file "example.db.in";
	dnssec-policy none;
};
