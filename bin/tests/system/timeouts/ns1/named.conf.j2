{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	dnssec-validation no;
	recursion no;
	notify no;
	tcp-initial-timeout 20;
	tcp-idle-timeout 50;
	tcp-keepalive-timeout 70;
	max-transfer-time-out 5; /* minutes */
	max-transfer-idle-out 1; /* minutes */
};

zone "." {
	type primary;
	file "root.db";
};

zone "example." {
	type primary;
	file "example.db";
	check-integrity no;
};
