options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	ixfr-from-differences yes;
};

{% include "_common/controls.conf.j2" %}

zone "spf" {
	type primary;
	file "spf.db";
};

zone "warn" {
	type primary;
	file "spf.db";
	check-spf warn;
};

zone "nowarn" {
	type primary;
	file "spf.db";
	check-spf ignore;
};
