{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	ixfr-from-differences secondary;
	check-integrity no;
};

{% include "_common/root.hint.conf" %}

zone "primary2" {
	type primary;
	file "primary2.db";
};

zone "secondary" {
	type secondary;
	primaries { 10.53.0.1; };
	file "sec.bk";
};

zone "edns-expire" {
	type secondary;
	primaries { 10.53.0.6; };
	file "edns-expire.bk";
};
