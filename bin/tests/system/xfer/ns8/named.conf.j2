{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	notify no;
	transfer-message-size 1024;
};

key key1. {
	algorithm @DEFAULT_HMAC@;
	secret "1234abcd8765";
};

acl tzkey {
	key key1.;
};

zone "example." {
	type primary;
	file "example.db";
	allow-transfer { tzkey; };
};
