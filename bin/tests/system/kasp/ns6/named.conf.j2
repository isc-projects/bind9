// NS6

include "policies/kasp.conf";
include "policies/csk1.conf";

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	key-directory ".";
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "../../_common/root.hint.blackhole";
};

zone example {
	type primary;
	file "example.db";
	dnssec-policy modified;
};
