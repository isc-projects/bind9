options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	max-records-per-type 0;
	max-types-per-name 0;
};

{% include "_common/controls.conf.j2" %}

zone "." { type primary; file "root.db"; };

zone "big." {
	type primary;
	file "big.db";
};

zone "signed." {
	type primary;
	file "signed.db.signed";
};
