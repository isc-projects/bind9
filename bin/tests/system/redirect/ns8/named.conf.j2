// NS8

options {
	query-source address 10.53.0.8;
	notify-source 10.53.0.8;
	transfer-source 10.53.0.8;
	port @PORT@;
	listen-on { 10.53.0.8; };
	pid-file "named.pid";
	nxdomain-redirect redirect;
	dnssec-validation no;
	dns64 64:ff9b::/96 {
		clients { any; };
		mapped { any; };
		suffix ::;
	};
};

{% include "_common/controls.conf.j2" %}

zone "." {
        type hint;
        file "root.hints";
};
