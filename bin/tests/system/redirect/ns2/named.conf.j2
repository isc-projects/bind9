// NS2

acl rfc1918 { 10/8; 192.168/16; 172.16/12; };

options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;

};


{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "../../_common/root.hint";
};

zone "." {
	type redirect;
	file "redirect.db";
	allow-query { !10.53.0.4; any; };
};

zone "example.nil" {
	type primary;
	file "example.db";
};
