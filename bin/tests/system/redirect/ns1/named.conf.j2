// NS1

acl rfc1918 { 10/8; 192.168/16; 172.16/12; };

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-recursion { @ns.ip@; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db";
};

zone "example" {
	type primary;
	file "example.db";
};

zone "signed" {
	type primary;
	file "signed.db.signed";
};

zone "nsec3" {
	type primary;
	file "nsec3.db.signed";
};

zone "." {
	type redirect;
	file "redirect.db";
	allow-query { !10.53.0.2; !10.53.0.4; any; };
};
