options {
	port @PORT@;
	query-source address 10.53.0.2;
	notify-source 10.53.0.2;
	listen-on { 10.53.0.2; };
	listen-on-v6 { none; };
	transfer-source 10.53.0.2;
	pid-file "named.pid";
	recursion no;
};

zone "foo.fr" {
	min-refresh-time 1;
	min-retry-time 1;
	type secondary;
	primaries { 10.53.0.1 port @PORT@; };
};

