options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	notify no;
	allow-new-zones yes;
	allow-transfer { none; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "existing" {
	type primary;
	file "example.db";
};

zone "duplicate" {
	type primary;
	file "example.db";

	# duplicate IP in a negated nested ACL
	allow-transfer { 10.53.0.1; !{ 10.53.0.1; }; };
};

zone "inexact" {
	type primary;
	file "example.db";

	# negated nested ACL that matches but not exactly
	allow-transfer { 10.53.0.1; !{ 10.53.0.0/16; }; };
};
