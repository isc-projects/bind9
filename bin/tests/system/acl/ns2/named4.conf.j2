{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	ixfr-from-differences yes;
	check-integrity no;
	dnssec-validation no;
};

key one {
	algorithm @DEFAULT_HMAC@;
	secret "1234abcd8765";
};

key two {
	algorithm @DEFAULT_HMAC@;
	secret "1234abcd8765";
};

acl rejectkeys {
	!key one; !key two; any;
};

acl rejectaddrs {
	!10.53.0.1; !@ns.ip@; any;
};

acl check1 { !key one; 10.53.0.1; };

acl check2 { !key two; @ns.ip@; };

{% include "_common/root.hint.conf" %}

zone "example" {
	type primary;
	file "example.db";
};

zone "tsigzone" {
	type primary;
	file "tsigzone.db";
	allow-transfer { !rejectkeys; !rejectaddrs; !check1; !check2; any; };
};
