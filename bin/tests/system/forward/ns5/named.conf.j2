options {
	{% include_indented "_common/options.conf.j2" %}
	forward only;
	forwarders { 10.53.0.4; };
	deny-answer-aliases { "rebind"; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "root.db";
};

zone "rebind" {
	type primary;
	file "rebind.db";
};
