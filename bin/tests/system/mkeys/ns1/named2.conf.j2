// NS1

acl allowed {
	! 10.53.0.5;
	any;
};

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	notify no;
	dnssec-validation no;
	allow-query { allowed; };
};


{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db.signed";
};

zone "tld" {
	type primary;
	file "tld.db.signed";
};

zone "sub.tld" {
	type primary;
	file "sub.tld.db.signed";
};
