options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	notify no;
};

{% include "_common/controls.conf.j2" %}

view "v1" {
	match-clients { any; };

	zone "." {
		type hint;
		file "/dev/null";
	};

	zone "example2" {
		type primary;
		file "example2.db";
		allow-query { key sig0.example2.; };
	};
};
