options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	allow-query-cache { none; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

view internal {
        match-destinations { 10.53.0.3; };
        zone "." {
                type hint;
                file "../../_common/root.hint";
        };
        recursion yes;
	allow-recursion{ any; };
};
