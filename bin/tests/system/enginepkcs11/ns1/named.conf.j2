options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	notify no;
};

{% include "_common/controls.conf.j2" %}

key-store "hsm" {
	directory ".";
	pkcs11-uri "pkcs11:token=kryoptic-enginepkcs11;pin-value={%- include "_common/hsm_pin" -%}";
};

key-store "pin" {
	directory ".";
	pkcs11-uri "pkcs11:token=kryoptic-enginepkcs11;pin-source=@pin_path@";
};

key-store "disk" {
	directory "keys";
};
