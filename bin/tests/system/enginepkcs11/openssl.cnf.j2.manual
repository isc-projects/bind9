openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
pkcs11 = pkcs11_sect

[default_sect]
activate = 1

[pkcs11_sect]
pkcs11-module-load-behavior = early
pkcs11-module-path = @pkcs11_module_path@
pkcs11-module-cache-keys = false
activate = 1
