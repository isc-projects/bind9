[ec_point_encoding]
encoding = "Der"

[[slots]]
slot = 0
dbtype = "sqlite"
dbargs = "@database@"
mechanisms = [
    "CKM_RSA_PKCS_KEY_PAIR_GEN",
    "CKM_RSA_PKCS",
    "CKM_EC_KEY_PAIR_GEN",
    "CKM_ECDSA",
    "CKM_EC_EDWARDS_KEY_PAIR_GEN",
    "CKM_EDDSA",
]
