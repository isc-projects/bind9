// validating resolver

{% set ans1 = Nameserver("ans1") %}
{% set ans4 = Nameserver("ans4") %}
{% set ns3 = Nameserver("ns3") %}

options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation yes;
	synth-from-dnssec yes;
};

{% include "_common/controls.conf.j2" %}

{% include "_common/root.hint.conf" %}

zone "f004.test" {
	type static-stub;
	server-addresses { @ans1.ip@; };
};

zone "f007.test" {
	type static-stub;
	server-addresses { @ns3.ip@; };
};

zone "f023.test" {
	type static-stub;
	server-addresses { @ans4.ip@; };
};

zone "evil.f023.test" {
	type static-stub;
	server-addresses { @ans4.ip@; };
};

{% include "_common/trusted.conf.j2" %}
