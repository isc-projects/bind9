options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	notify no;
	rrset-order {
		name "cyclic.example" order cyclic;
		name "none.example" order none;
		type NS order random;
		order cyclic;
	};
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db";
	notify explicit;
	also-notify { 10.53.0.2; };
};
