// NS2

options {
	{% include_indented "_common/options-dual.conf.j2" %}
	recursion no;
	dnssec-validation no;
	minimal-any no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "../../_common/root.hint";
};

zone "example" {
	type primary;
	file "example.db";
};

zone "example.tld" {
	type primary;
	file "example.tld.db";
	provide-zoneversion no;
};
