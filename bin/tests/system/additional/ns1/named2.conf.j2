options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	notify no;
	minimal-responses no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db";
};

zone "rt.example" {
	type primary;
	file "rt.db";
};

zone "naptr.example" {
	type primary;
	file "naptr.db";
};

zone "rt2.example" {
	type primary;
	file "rt2.db";
};

zone "naptr2.example" {
	type primary;
	file "naptr2.db";
};

zone "nid.example" {
	type primary;
	file "nid.db";
};
