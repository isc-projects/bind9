// NS4

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "ns2" {
	type secondary;
	primaries source @ns.ip@ { 10.53.0.2 port @PORT@; };
	file "ns2.db";
};

