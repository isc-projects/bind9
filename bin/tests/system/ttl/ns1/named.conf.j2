	dnssec-validation no;
	check-integrity no;
};

zone "." {
	type hint;
	file "../../_common/root.hint";
};

zone "min-example" {
	type primary;
	file "min-example.db";
};

zone "max-example" {
	type primary;
	file "max-example.db";
};
