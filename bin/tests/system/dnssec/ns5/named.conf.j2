// NS5

{% set revoked_key = revoked_key | default(False) %}
{% set broken_key = broken_key | default(False) %}
{% set many_anchors = many_anchors | default(False) %}
options {
	{% include_indented "_common/options/sources.conf.j2" %}
	{% include_indented "_common/options/server.conf.j2" %}
	listen-on { @ns.ip@; 127.0.0.1; };
	listen-on-v6 { none; };
	minimal-any no;
	minimal-responses no;
	servfail-ttl 0;

{% if many_anchors %}
	dnssec-validation yes;
	disable-algorithms "disabled.managed." { @DISABLED_ALGORITHM@; };
	disable-algorithms "disabled.trusted." { @DISABLED_ALGORITHM@; };
{% endif %}
};

{% include "_common/controls.conf.j2" %}

{% if revoked_key %}
	view root {
		match-destinations { 127.0.0.1; };
		dnssec-validation no;

		zone "." {
			type primary;
			file "root.db.signed";
		};
	};

	view other {
		dnssec-validation yes;
		include "revoked.conf";

		zone "." {
			type static-stub;
			server-addresses { 127.0.0.1; };
		};
	};
{% elif broken_key %}
	{% include_indented "_common/root.hint.conf" %}

	include "broken.conf";
{% elif many_anchors %}
	{% include_indented "_common/root.hint.conf" %}

	include "many-managed.conf";
	include "many-trusted.conf";
{% else %}
	{% include_indented "_common/root.hint.conf" %}

	include "trusted.conf";
{% endif %}
