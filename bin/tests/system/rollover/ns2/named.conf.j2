// NS2

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	allow-notify { 10.53.0.3; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "../../_common/root.hint";
};

{% for zone in tlds %}
zone "@zone@" {
	type primary;
	file "@zone@.db.signed";
};
{% endfor %}
