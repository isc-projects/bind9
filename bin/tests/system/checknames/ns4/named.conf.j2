options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	dnssec-validation no;
	check-names primary ignore;
	check-names secondary ignore;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "root.hints";
};

zone "primary-ignore.update" {
	type primary;
	file "primary-ignore.update.db";
	allow-update { any; };
};

zone "master-ignore.update" {
	type secondary;
	primaries { 10.53.0.5; };
	file "secondary-ignore.update.db";
};
