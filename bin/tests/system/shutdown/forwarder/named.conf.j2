key rndc_key {
	secret "1234abcd8765";
	algorithm @DEFAULT_HMAC@;
};
controls {
	inet 10.53.0.3 port @CONTROLPORT@ allow { any; } keys { rndc_key; };
};
options {
	port @PORT@;
	listen-on { 10.53.0.3; };
	listen-on-v6 { none; };
	pid-file "named.pid";
	recursion no;
	dnssec-validation no;
	notify no;
};
view "@ 'replacement' if retired | default(false) else 'original' @" {
{% if not retired | default(false) %}
	zone "forward.test" {
		type secondary;
		file "forward.db";
		primaries { 10.53.0.4 port @PORT@; };
		allow-update-forwarding { any; };
	};
{% endif %}
};
