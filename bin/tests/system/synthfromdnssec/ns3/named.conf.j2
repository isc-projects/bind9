// NS3

options {
	{% include_indented "_common/options.conf.j2" %}
	notify no;
	dnssec-validation yes;
};

{% include "_common/controls.conf.j2" %}

{% if FEATURE_LIBXML2 == "1" or FEATURE_JSON_C == "1" %}
statistics-channels {
	inet 10.53.0.3 port @EXTRAPORT1@ allow { any; };
};
{% endif %}

zone "." {
	type hint;
	file "root.hints";
};

zone "." {
	type redirect;
	file "redirect.db";
};

include "../ns1/trusted.conf";
