options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	recursion no;
};

logging {
	channel default_log {
		file "named_log";
		print-time yes;
	};
	category default { default_log; default_debug; };
	category lame-servers { null; };

	channel query_log {
		file "query_log";
		print-time yes;
		buffered yes;
	};
	category queries { query_log; };
};

