options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	recursion no;
};

logging {
	channel default_log {
		file "named_iso8601_utc";
		print-time iso8601-utc;
		severity debug 9;
	};
	category default { default_log; default_debug; };
};

