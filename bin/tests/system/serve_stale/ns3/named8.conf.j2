{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	stale-answer-enable yes;
	stale-cache-enable yes;
	stale-answer-client-timeout 0;
	prefetch 2 8;
	dns64 2001:aaaa::/96 {
		clients { any; };
		mapped { any; };
	};
};

zone "." {
	type secondary;
	primaries { 10.53.0.1; };
	file "root.bk";
};
