// NS3

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	notify no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "example" {
	type primary;
	masterfile-format raw;
	file "example.db.raw";
};

zone "dynamic" {
	type primary;
	masterfile-format raw;
	file "dynamic.db.raw";
	allow-update { any; };
};
