options {
	{% include_indented "_common/options.conf.j2" %}
	notify no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db";
};

zone "root-servers.nil" {
	type primary;
	file "root-servers.nil.db";
};

zone "net" {
	type primary;
	file "net.db";
};

zone "tc-test-unsigned" {
	type master;
	file "tc-test-unsigned.db";
};

zone "tc-test-signed" {
	type master;
	file "tc-test-signed.db.signed";
};
