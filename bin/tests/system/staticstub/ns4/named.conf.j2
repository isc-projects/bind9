options {
	{% include_indented "_common/options/sources.conf.j2" %}
	{% include_indented "_common/options/server.conf.j2" %}
	listen-on { @ns.ip@; };
	listen-on-v6 { ::1; };
	recursion no;
	dnssec-validation no;
	notify no;
};

{% include "_common/controls.conf.j2" %}

zone "example.com" {
	type primary;
	file "example.com.db";
};

zone "example.org" {
	type primary;
	file "example.org.db";
};

zone "sub.example" {
	type primary;
	file "sub.example.db.signed";
};

zone "example.info" {
	type primary;
	file "example.info.db";
};
