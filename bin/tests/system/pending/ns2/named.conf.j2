// NS2

include "trusted.conf";

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation yes;
};

{% include "_common/controls.conf.j2" %}

{% include "_common/root.hint.conf" %}

zone "example" {
	type primary;
	file "example.db.signed";
};

zone "example.com" {
	type primary;
	file "example.com.db.signed";
	allow-update { 10.53.0.0/16; };
};

zone "good" {
	type primary;
	file "forgery.db";
	allow-query { any; };
};
