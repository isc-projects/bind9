# common configuration
include "named.conf.header";

view "recursive" {
	zone "." {
		type hint;
		file "root.hint";
	};

	# policy configuration to be tested
	response-policy {
{% for zone in policy_zones %}
		zone "@zone@";
{% endfor %}
	} nsdname-enable yes nsip-enable yes{% if not qname_wait_recurse %} qname-wait-recurse no{% endif %};

	# policy zones to be tested
{% for zone in policy_zones %}
	zone "@zone@" { type primary; file "db.@zone@"; };
{% endfor %}
};
