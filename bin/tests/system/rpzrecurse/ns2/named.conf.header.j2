options {
	{% include_indented "_common/options.conf.j2" %}
	session-keyfile "session.key";
	dnssec-validation no;
	querylog yes;
{% if dnsrps | default(False) %}

	dnsrps-options { log-level 3 };
	dnsrps-enable yes;
	dnsrps-library "@TOP_BUILDDIR@/bin/tests/system/rpz/testlib/.libs/libdummyrpz.so";
{% endif %}
};

