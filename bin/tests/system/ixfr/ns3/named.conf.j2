options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

view "primary" {
	ixfr-from-differences yes;
	request-ixfr yes;
	zone "test" IN {
		type primary;
		file "mytest.db";
		max-ixfr-ratio 75%;
	};
	zone "sub.test" IN {
		type primary;
		file "subtest.db";
	};
	zone "large" IN {
		type primary;
		file "large.db";
	};
};
