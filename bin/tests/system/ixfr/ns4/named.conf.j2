options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

view "primary" {
	ixfr-from-differences yes;
	request-ixfr yes;
	zone "test" IN {
		type secondary;
		file "mytest.db";
		primaries { 10.53.0.3; };
		max-ixfr-ratio unlimited;
	};
	zone "sub.test" IN {
		type secondary;
		file "subtest.db";
		request-ixfr no;
		primaries { 10.53.0.3; };
	};
};
