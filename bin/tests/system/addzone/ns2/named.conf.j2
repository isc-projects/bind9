options {
	{% include_indented "_common/options.conf.j2" %}
	allow-query { any; };
	recursion no;
	allow-new-zones yes;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

template primary {
	type primary;
	file "$view-$name.db";
	initial-file "added.db";
};

template bad {
	type secondary;
	primaries { 10.53.0.1; };
	max-refresh-time 0;
	max-retry-time 0;
	min-refresh-time 0;
	min-retry-time 0;
};

{% include "_common/root.hint.conf" %}

zone "normal.example" {
	type primary;
	file "normal.db";
};

zone "finaldot.example." {
	type primary;
	file "normal.db";
};
