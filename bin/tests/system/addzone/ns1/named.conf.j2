{% set allownewzones = allownewzones | default(True) %}

{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	allow-query { any; };
{% if allownewzones %}
	allow-new-zones yes;
{% else %}
	allow-new-zones no;
{% endif %}
	recursion no;
	dnssec-validation no;
};

{% include "_common/root.hint.conf" %}

zone "inlinesec.example" {
	type primary;
	file "inlinesec.db";
};

zone "." {
	type redirect;
	file "redirect.db";
};
