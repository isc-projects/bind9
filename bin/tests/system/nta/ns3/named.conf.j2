// NS3

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	minimal-responses no;
};

{% include "_common/controls.conf.j2" %}

zone "example" {
	type secondary;
	primaries { 10.53.0.2; };
	file "example.bk";
};

zone "secure.example" {
	type primary;
	file "secure.example.db.signed";
	allow-update { any; };
};

zone "bogus.example" {
	type primary;
	file "bogus.example.db.signed";
	allow-update { any; };
};

zone "badds.example" {
	type primary;
	file "badds.example.db.signed";
	allow-update { any; };
};
