// NS1

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation yes;
	/* test that we can turn off trust-anchor-telemetry */
	trust-anchor-telemetry no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db.signed";
};

include "trusted.conf";
