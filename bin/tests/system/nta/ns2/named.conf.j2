// NS2

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	notify-delay 1;
	dnssec-validation no;
	minimal-responses no;
};

{% include "_common/controls.conf.j2" %}

zone "example" {
	type primary;
	file "example.db.signed";
	allow-update { any; };
};

zone "corp" {
	type primary;
	file "corp.db";
};
