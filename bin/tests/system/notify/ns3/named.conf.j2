{% if FEATURE_FIPS_DH == "1" %}
include "named-tls.conf";
{% endif %}

options {
	{% include_indented "_common/options-dual.conf.j2" %}
	dnssec-validation no;

	tcp-initial-timeout 150; # 15 seconds

{% if FEATURE_FIPS_DH == "1" %}
	tls-port @TLSPORT@;
{% endif %}

};

{% include "_common/controls.conf.j2" %}

{% include "_common/root.hint.conf" %}

key "test" {
	secret "1234abcd8765";
	algorithm hmac-sha256;
};

zone "example" {
	type secondary;
	primaries { 10.53.0.2; };
	file "example.bk";
	# non-responsive notify recipient (no reply, no ICMP errors)
	also-notify { 10.53.10.53 key test; };
};

zone "notify-source-port-test" {
	type primary;
	file "notify-source-port-test.db";
	notify-source @ns.ip@;
};
