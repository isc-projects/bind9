{% set noextension = noextension | default(False) %}

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	minimal-responses no;
};

{% if noextension %}
plugin query "@TOP_BUILDDIR@/testlib-driver-async";
{% else %}
plugin query "@TOP_BUILDDIR@/testlib-driver-async.@DYLIB@";
{% endif %}

{% include "_common/controls.conf.j2" %}

zone "example.com" {
	type primary;
	file "example.db";
};
