options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	ixfr-from-differences yes;
	check-integrity no;
	minimal-responses no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "example" {
	type primary;
	file "example.db";
	also-notify { 10.53.0.2; };
};

zone "dynamic" {
	type primary;
	file "dynamic.db";
	allow-update { any; };
	also-notify { 10.53.0.2; };
};
