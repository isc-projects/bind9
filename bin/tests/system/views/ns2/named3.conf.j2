{% set zone_names = zone_names | default([]) %}

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	notify no;
};

{% include "_common/controls.conf.j2" %}

{% for name in zone_names %}
zone "@name@" {
    type primary;
    file "@name@.db";
    dnssec-policy default;
    inline-signing yes;
};
{% endfor %}
