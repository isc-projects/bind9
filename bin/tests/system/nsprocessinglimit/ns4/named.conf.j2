options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	dnstap { resolver query; };
	dnstap-output file "dnstap.out";
};

/*
 * The sub.example.tld servers: skipped once selected, so that the test
 * does not depend on how fast the OS fails a query to them.
 */
server 127.0.0.0/8 { bogus yes; };

