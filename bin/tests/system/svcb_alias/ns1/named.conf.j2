{% include "_common/controls.conf.j2" %}
options {
	query-source address @ns.ip@;
	notify-source @ns.ip@;
	transfer-source @ns.ip@;
	port @PORT@;
	pid-file "named.pid";
	listen-on { @ns.ip@; };
	listen-on-v6 { none; };
	recursion yes;
	dnssec-validation no;
	allow-query { any; };
	allow-recursion { any; };
	// minimal-responses defaults to no-auth-recursive, the affected setting
};

zone "." {
	type hint;
	file "root.hint";
};
