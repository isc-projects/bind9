// NS1

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation yes;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db.signed";
	allow-transfer { any; };
	allow-update { any; };
	allow-query { any; };
};

include "trusted.conf";
