; The valid glue of a.root-servers.nil is parsed before the load fails
; on the broken record of b.root-servers.nil.
$TTL 999999
.			IN NS	a.root-servers.nil.
.			IN NS	b.root-servers.nil.
a.root-servers.nil.	IN A	10.53.0.99
b.root-servers.nil.	IN A	not-an-address
