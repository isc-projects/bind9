// NS4

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

remote-servers "ns3" {
	10.53.0.3 port @PORT@;
};

zone "retransfer.kasp" {
	type secondary;
	file "retransfer.kasp.db";
	primaries { "ns3"; };
	allow-notify { any; };
	notify no;
};
