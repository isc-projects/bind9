/*
 * Main rpz test DNS server.
 */

options {
	{% include_indented "_common/options.conf.j2" %}
	statistics-file	"named.stats";
	session-keyfile "session.key";
	allow-transfer { any; };
	minimal-any no;
	minimal-responses no;
	dnssec-validation no;

	response-policy {
	    zone "manual-update-rpz";
	}
	// add-soa yes // do not set testing default mode
	min-ns-dots 0
	qname-wait-recurse yes
	min-update-interval 0
	nsdname-enable yes
	nsip-enable yes
	;

	also-notify { @ns.ip@ port @EXTRAPORT1@; };
	notify-delay 0;
};


logging { category rpz { default_debug; }; };
{% include "_common/controls.conf.j2" %}


zone "." { type hint; file "hints"; };

zone "manual-update-rpz." {
	type primary;
	file "manual-update-rpz.db";
	notify no;
};
